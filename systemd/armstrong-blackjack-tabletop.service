[Unit]
Description=Armstrong blackjack tabletop (motion disabled)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/armstrong
ExecStart=/usr/bin/python3 %h/armstrong/tools/blackjack/tabletop_server.py --host 0.0.0.0 --port 8202
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
